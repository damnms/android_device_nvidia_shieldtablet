import /vendor/etc/init/hw/init.gps.rc
import /vendor/etc/init/hw/init.tn8diag.rc

on early-init
    # create /oem symbol link
    symlink /system/vendor/oem /oem
    chmod 0755 /oem
    chown root system /oem

on post-fs-data
    setprop init.svc.vendor.lkm_loader stopped

on boot
    # cpusets (init.rc gives every group all cores): background work stays
    # on CPU0, which cpuquiet never takes offline and which also runs the
    # LP cluster, so the other cores stay free for the foreground.
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-2
    write /dev/cpuset/restricted/cpus 0-1
    write /dev/cpuset/background/cpus 0

on init
    setprop persist.tegra.cursor.enable 1
    setprop keyguard.no_require_sim true
    setprop persist.tegra.didim.enable 0
    write /d/tegra_actmon/cpu_emc/avg_act_threshold 50000

service charger /charger
    class charger
    seclabel u:r:healthd:s0
    group input

on charger
    setprop persist.sys.usb.config mtp
    mount ext4 /dev/block/platform/sdhci-tegra.3/by-name/APP /system wait ro
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/enable 1
    write /sys/devices/system/cpu/cpuquiet/current_governor runnable
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp -1

# The bootloader passes console=ttyS0. Do not keep the userdebug console
# shell running on it (Android warns "serial console enabled" otherwise).
on init && property:ro.debuggable=1
    stop console
