<!-- Applied only on the Wi-Fi model, where the bootloader reports no modem. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.overlay.shieldtablet.wifionly.settings">
    <overlay
        android:targetPackage="com.android.settings"
        android:requiredSystemPropertyName="ro.boot.modem"
        android:requiredSystemPropertyValue="none"
        android:isStatic="true"
        android:priority="10" />
</manifest>
