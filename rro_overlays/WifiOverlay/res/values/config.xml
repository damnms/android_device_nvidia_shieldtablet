<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The bcmdhd driver only accepts the PSK and 802.1X AKMs (wl_set_key_mgmt).
         With WPA-PSK-SHA256 added, wpa_supplicant picks it on WPA2/WPA3 transition
         mode networks and the connect fails ("Invalid key mgmt"). -->
    <bool name="config_wifiSha256KeyMgmtSupported">false</bool>
    <!-- No telephony: take the country from the 802.11d Country element of nearby
         access points. bcmdhd maps it to a firmware locale (e.g. DE/0 with the DFS
         channels); unknown countries stay on the worldwide XV/994. -->
    <bool name="config_wifiCountryCodeFromScanResults">true</bool>
    <!-- Randomized MAC per network (AOSP default is off). The legacy HAL sets it via
         IWifiStaIface@1.2::setMacAddress; bcmdhd applies the address when wlan0 comes up. -->
    <bool name="config_wifi_connected_mac_randomization_supported">true</bool>
</resources>
